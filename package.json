{
  "name": "@cocartheadless/sdk",
  "version": "1.2.1",
  "description": "Official TypeScript SDK for the CoCart REST API",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/index.global.js",
  "jsdelivr": "./dist/index.global.js",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./astro": {
      "import": {
        "types": "./dist/adapters/astro.d.ts",
        "default": "./dist/adapters/astro.js"
      }
    },
    "./nextjs": {
      "import": {
        "types": "./dist/adapters/nextjs.d.ts",
        "default": "./dist/adapters/nextjs.js"
      }
    },
    "./deno": {
      "import": {
        "types": "./dist/adapters/deno.d.ts",
        "default": "./dist/adapters/deno.js"
      }
    },
    "./nuxt": {
      "import": {
        "types": "./dist/adapters/nuxt.d.ts",
        "default": "./dist/adapters/nuxt.js"
      }
    },
    "./remix": {
      "import": {
        "types": "./dist/adapters/remix.d.ts",
        "default": "./dist/adapters/remix.js"
      }
    },
    "./svelte": {
      "import": {
        "types": "./dist/adapters/svelte.d.ts",
        "default": "./dist/adapters/svelte.js"
      }
    },
    "./elysiajs": {
      "import": {
        "types": "./dist/adapters/elysiajs.d.ts",
        "default": "./dist/adapters/elysiajs.js"
      }
    },
    "./fastify": {
      "import": {
        "types": "./dist/adapters/fastify.d.ts",
        "default": "./dist/adapters/fastify.js"
      }
    },
    "./hono": {
      "import": {
        "types": "./dist/adapters/hono.d.ts",
        "default": "./dist/adapters/hono.js"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/adapters/vite.d.ts",
        "default": "./dist/adapters/vite.js"
      }
    },
    "./tanstack-start": {
      "import": {
        "types": "./dist/adapters/tanstack-start.d.ts",
        "default": "./dist/adapters/tanstack-start.js"
      }
    },
    "./i18n/en-us": {
      "import": {
        "types": "./dist/i18n/en-us.d.ts",
        "default": "./dist/i18n/en-us.js"
      },
      "require": {
        "types": "./dist/i18n/en-us.d.cts",
        "default": "./dist/i18n/en-us.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && tsup --config tsup.adapters.ts && tsup --config tsup.cdn.ts && tsup --config tsup.i18n.ts",
    "build:checkout": "npm run build --workspace @cocartheadless/checkout",
    "build:all": "npm run build && npm run build:checkout",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "typecheck:checkout": "npm run typecheck --workspace @cocartheadless/checkout",
    "typecheck:datafast": "npm run typecheck --workspace @cocartheadless/analytics-datafast",
    "build:datafast": "npm run build --workspace @cocartheadless/analytics-datafast",
    "test": "vitest run",
    "test:checkout": "npm run test --workspace @cocartheadless/checkout",
    "test:all": "npm run test && npm run test:checkout",
    "test:watch": "vitest",
    "test:datafast": "npm run test --workspace @cocartheadless/analytics-datafast",
    "typecheck:gtm": "npm run typecheck --workspace @cocartheadless/analytics-gtm",
    "build:gtm": "npm run build --workspace @cocartheadless/analytics-gtm",
    "test:gtm": "npm run test --workspace @cocartheadless/analytics-gtm",
    "lint": "tsc --noEmit",
    "dev:preview": "npm run dev --workspace @cocartheadless/checkout-preview",
    "build:preview": "npm run build --workspace @cocartheadless/checkout-preview",
    "release": "node scripts/release.mjs"
  },
  "keywords": [
    "cocart",
    "woocommerce",
    "cart",
    "checkout",
    "payment-gateway",
    "headless",
    "sdk",
    "typescript",
    "rest-api"
  ],
  "author": "CoCart Headless, LLC",
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "overrides": {
    "picomatch": ">=4.0.4"
  }
}
