{
  "name": "@cocartheadless/analytics-datafast",
  "version": "1.0.0",
  "description": "Datafast analytics extension for the CoCart SDK",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests"
  },
  "keywords": [
    "cocart",
    "woocommerce",
    "headless",
    "analytics",
    "datafast",
    "sdk",
    "typescript"
  ],
  "author": "CoCart Headless, LLC",
  "license": "MIT",
  "peerDependencies": {
    "@cocartheadless/sdk": ">=1.1.0"
  },
  "dependencies": {
    "datafast": "latest"
  },
  "devDependencies": {
    "@cocartheadless/sdk": "file:../..",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
