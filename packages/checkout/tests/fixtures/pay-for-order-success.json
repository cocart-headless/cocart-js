{
  "name": "Pays for an unpaid order: the result reads as for placeOrder, and the order key goes in the body",
  "source": "CoCart Plus 2.0 checkout spec",
  "call": {
    "target": "checkout",
    "method": "payForOrder",
    "args": [
      1234,
      "wc_order_abc123",
      {
        "payment_method": "stripe",
        "payment_data": {
          "wc-stripe-payment-method": "pm_1H8x2y2eZvKYlo2C"
        }
      }
    ]
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "cocart/v2/order-received/1234/pay",
        "query": {},
        "body": {
          "payment_method": "stripe",
          "payment_data": [
            {
              "key": "wc-stripe-payment-method",
              "value": "pm_1H8x2y2eZvKYlo2C"
            }
          ],
          "order_key": "wc_order_abc123"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "object": "order",
          "result": {
            "code": "order_placed",
            "message": "Thank you. Your order has been received.",
            "action": null,
            "redirect_url": "https://shop.example.com/checkout/order-received/1234/?key=wc_order_abc123&order_id=1234",
            "error": null
          },
          "id": 1234,
          "number": "1234",
          "key": "wc_order_abc123",
          "status": {
            "code": "processing",
            "label": "Processing"
          },
          "currency": {
            "currency_code": "USD",
            "currency_symbol": "$",
            "currency_minor_unit": 2
          },
          "item_count": 1,
          "totals": {
            "subtotal": "1800",
            "total_tax": "0",
            "shipping_total": "500",
            "total": "2300"
          },
          "payment": {
            "method": "stripe",
            "title": "Credit card",
            "needs_payment": false,
            "date_paid": null
          },
          "actions": {}
        }
      }
    }
  ],
  "expect": {
    "result": {
      "code": "order_placed",
      "isComplete": true,
      "orderId": 1234,
      "orderKey": "wc_order_abc123",
      "orderNumber": "1234",
      "orderStatus": "processing",
      "redirectUrl": "https://shop.example.com/checkout/order-received/1234/?key=wc_order_abc123&order_id=1234"
    }
  }
}
