{
  "name": "Decodes the return URL's query (percent-encoding, + as a space) and ignores the fragment",
  "source": "CoCart Plus 2.0 checkout spec",
  "call": {
    "target": "checkout",
    "method": "confirmReturn",
    "args": [
      "https://shop.example.com/checkout/order-received/217/?key=wc_order_abc&order_id=217&note=a%26b+c#top"
    ]
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "cocart/v2/order-received/217/confirm",
        "query": {},
        "body": {
          "order_key": "wc_order_abc",
          "return_params": {
            "key": "wc_order_abc",
            "order_id": "217",
            "note": "a&b c"
          }
        }
      },
      "response": {
        "status": 200,
        "body": {
          "object": "order",
          "result": {
            "code": "order_placed",
            "message": "Thank you. Your order has been received.",
            "action": null,
            "redirect_url": "https://shop.example.com/checkout/order-received/217/?key=wc_order_abc",
            "error": null
          },
          "id": 217,
          "number": "217",
          "key": "wc_order_abc",
          "status": {
            "code": "processing",
            "label": "Processing"
          },
          "currency": {
            "currency_code": "USD",
            "currency_symbol": "$",
            "currency_minor_unit": 2
          },
          "item_count": 1,
          "totals": {
            "subtotal": "1800",
            "total_tax": "0",
            "shipping_total": "500",
            "total": "2300"
          },
          "payment": {
            "method": "stripe",
            "title": "Credit card",
            "needs_payment": false,
            "date_paid": null
          },
          "allowed_actions": []
        }
      }
    }
  ],
  "expect": {
    "result": {
      "code": "order_placed"
    }
  }
}
