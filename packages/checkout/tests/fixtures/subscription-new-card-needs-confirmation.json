{
  "name": "Switches a subscription to a new card: payment_data sent as pairs; a SetupIntent gives needsConfirmation",
  "source": "CoCart Plus 2.0 checkout spec",
  "call": {
    "target": "account",
    "method": "updateSubscriptionPaymentMethod",
    "args": [
      512,
      {
        "payment_method": "stripe",
        "payment_data": {
          "wc-stripe-payment-method": "pm_card_threeDSecure2Required"
        }
      }
    ]
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "cocart/v2/my-account/subscriptions/512/payment-method",
        "query": {},
        "body": {
          "payment_method": "stripe",
          "payment_data": [
            {
              "key": "wc-stripe-payment-method",
              "value": "pm_card_threeDSecure2Required"
            }
          ]
        }
      },
      "response": {
        "status": 200,
        "body": {
          "object": "subscription",
          "result": {
            "code": "action_required",
            "message": "Confirm the new payment method to finish changing it.",
            "action": {
              "type": "stripe_confirm_payment",
              "data": {
                "client_secret": "seti_secret_512",
                "intent_type": "setup_intent"
              }
            },
            "redirect_url": null,
            "error": null
          },
          "id": 512,
          "number": "512",
          "status": {
            "code": "active",
            "label": "Active"
          },
          "payment": {
            "method": "stripe",
            "title": "Credit card",
            "needs_payment": false
          },
          "actions": {}
        }
      }
    }
  ],
  "expect": {
    "result": {
      "code": "action_required",
      "needsConfirmation": true,
      "clientSecret": "seti_secret_512",
      "intentType": "setup_intent",
      "subscriptionId": 512
    }
  }
}
