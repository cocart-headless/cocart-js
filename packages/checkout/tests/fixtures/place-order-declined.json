{
  "name": "A declined card is a failed result with CoCart's error code, not an exception",
  "source": "CoCart Plus 2.0 checkout spec",
  "call": {
    "target": "checkout",
    "method": "placeOrder",
    "args": [
      {
        "billing_address": {
          "first_name": "Jane",
          "last_name": "Doe",
          "address_1": "1 Main Street",
          "city": "Paris",
          "postcode": "75001",
          "country": "FR",
          "email": "jane@example.com"
        },
        "shipping_method": "flat_rate:1",
        "payment_method": "stripe",
        "payment_data": {
          "wc-stripe-payment-method": "pm_card_chargeDeclined"
        },
        "checkout_id": "chk_fixture_0000000001"
      }
    ]
  },
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "cocart/v2/checkout",
        "query": {},
        "body": {
          "billing_address": {
            "first_name": "Jane",
            "last_name": "Doe",
            "address_1": "1 Main Street",
            "city": "Paris",
            "postcode": "75001",
            "country": "FR",
            "email": "jane@example.com"
          },
          "shipping_method": "flat_rate:1",
          "payment_method": "stripe",
          "payment_data": [
            {
              "key": "wc-stripe-payment-method",
              "value": "pm_card_chargeDeclined"
            }
          ],
          "checkout_id": "chk_fixture_0000000001"
        }
      },
      "response": {
        "status": 200,
        "body": {
          "object": "order",
          "result": {
            "code": "payment_failed",
            "message": "Your card was declined.",
            "action": null,
            "redirect_url": null,
            "error": {
              "code": "card_declined",
              "gateway_code": "generic_decline",
              "gateway_message": "Your card was declined."
            }
          },
          "id": 217,
          "number": "217",
          "key": "wc_order_abc",
          "status": {
            "code": "failed",
            "label": "Failed"
          },
          "currency": {
            "currency_code": "USD",
            "currency_symbol": "$",
            "currency_minor_unit": 2
          },
          "item_count": 1,
          "totals": {
            "subtotal": "1800",
            "total_tax": "0",
            "shipping_total": "500",
            "total": "2300"
          },
          "payment": {
            "method": "stripe",
            "title": "Credit card",
            "needs_payment": true,
            "date_paid": null
          },
          "actions": {}
        }
      }
    }
  ],
  "expect": {
    "result": {
      "code": "payment_failed",
      "isComplete": false,
      "isFailed": true,
      "message": "Your card was declined.",
      "errorCode": "card_declined",
      "gatewayErrorCode": "generic_decline",
      "gatewayMessage": "Your card was declined.",
      "orderId": 217
    }
  }
}
