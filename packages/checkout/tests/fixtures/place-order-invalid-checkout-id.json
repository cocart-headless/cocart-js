{
  "name": "A checkout_id CoCart Plus wouldn't accept is refused before anything is sent",
  "source": "CoCart Plus 2.0 checkout spec",
  "call": {
    "target": "checkout",
    "method": "placeOrder",
    "args": [
      {
        "billing_address": {
          "first_name": "Jane",
          "last_name": "Doe",
          "address_1": "1 Main Street",
          "city": "Paris",
          "postcode": "75001",
          "country": "FR",
          "email": "jane@example.com"
        },
        "shipping_method": "flat_rate:1",
        "payment_method": "stripe",
        "payment_data": {
          "wc-stripe-payment-method": "pm_123"
        },
        "checkout_id": "too short"
      }
    ]
  },
  "exchanges": [],
  "expect": {
    "error": {
      "code": "checkout_invalid_checkout_id"
    }
  }
}
