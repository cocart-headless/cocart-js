{
  "name": "@cocartheadless/checkout",
  "version": "0.1.0",
  "description": "Checkout SDK for CoCart API with payment gateway helpers",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests"
  },
  "keywords": [
    "cocart",
    "woocommerce",
    "checkout",
    "stripe",
    "paypal",
    "authorizenet",
    "typescript",
    "headless"
  ],
  "author": "CoCart Headless, LLC",
  "license": "MIT",
  "peerDependencies": {
    "@cocartheadless/sdk": "^1.1.2"
  },
  "devDependencies": {
    "@cocartheadless/sdk": "file:../.."
  }
}
