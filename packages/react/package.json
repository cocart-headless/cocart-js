{
  "name": "@cocartheadless/react",
  "version": "1.0.0",
  "description": "React bindings for the CoCart SDK — CoCartProvider and useAuth() for reactive authentication state",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests"
  },
  "keywords": [
    "cocart",
    "woocommerce",
    "headless",
    "react",
    "hooks",
    "authentication",
    "sdk",
    "typescript"
  ],
  "author": "CoCart Headless, LLC",
  "license": "MIT",
  "peerDependencies": {
    "@cocartheadless/sdk": ">=1.2.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@cocartheadless/sdk": "file:../..",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^18.3.0",
    "jsdom": "^25.0.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
